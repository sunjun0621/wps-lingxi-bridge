/chat_log.txt
/account_probe.txt
/sessions_now.txt
/state_report.txt
/realinput_report.txt
/gslice_out.txt
/slice_out.txt
/common_extract.txt
/asar_filelist.txt

# ---------- WPS 网页代码提取（版权） ----------
/common.js
/kso-sdk.js

# ---------- 缓存 / 备份 / 个人数据 ----------
__pycache__/
*.pyc
/_cleanup_backup/
/.workbuddy/
*.bak-*

